# --- LLM provider: groq | gemini | ollama ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval ---
QDRANT_URL=http://localhost:6333
# Qdrant Cloud only
QDRANT_API_KEY=
QDRANT_COLLECTION=support_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# --- Database (docker-compose overrides this with the postgres service) ---
DATABASE_URL=sqlite:///data/processed/supportpilot.db
# DATABASE_URL=postgresql+psycopg://supportpilot:supportpilot@localhost:5433/supportpilot  (docker compose postgres)

# --- Agent ---
MAX_AGENT_STEPS=8

# --- Tickets ---
DUPLICATE_WINDOW_HOURS=24
DUPLICATE_SIMILARITY=0.85
REVIEW_CONFIDENCE_THRESHOLD=0.40
REVIEW_PRIORITY_THRESHOLD=0.50

CLASSIFIER_MODEL_DIR=models/distilbert
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- API / staff auth (ENVIRONMENT=production refuses the defaults) ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=change-me
STAFF_USERNAME=admin
STAFF_PASSWORD=admin
DEMO_USERNAME=demo
# set to enable the read-only demo login
DEMO_PASSWORD=

# --- Public demo protection ---
RATE_LIMITS=true
DAILY_CHAT_LIMIT=300

# --- Trust (Phase 8) ---
# verify answer claims against the docs (gpt-oss-20b)
SELF_CHECK=true
# Prompt Guard flags likely injections (never blocks)
INPUT_GUARD=true
OUTPUT_GUARD=true

# --- Ticket classifier (int8 ONNX in models/onnx; PyTorch checkpoint in models/distilbert as a fallback) ---
# false on 512 MB hosts
CLASSIFIER_KEEP_LOADED=true

# --- Observability (Langfuse cloud free tier or self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
