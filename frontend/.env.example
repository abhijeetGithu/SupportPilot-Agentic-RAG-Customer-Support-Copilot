# Local development: leave empty (the browser calls /api, proxied by next.config.ts to API_URL).
API_URL=http://localhost:8000
# Production (Vercel): call the backend directly, e.g. https://supportpilot-api.onrender.com/api
NEXT_PUBLIC_API_BASE=
# Read-only demo login shown on the staff login page, "user:password" (never the admin login)
NEXT_PUBLIC_DEMO_LOGIN=
